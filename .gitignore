# =============================================================================
# .gitignore — files Git should NOT track and upload to GitHub
# =============================================================================

# Jekyll build output (regenerated by GitHub Pages on every push)
_site/
.jekyll-cache/
.jekyll-metadata
.sass-cache/

# Ruby/Bundler local state (only relevant if you ever install Jekyll locally)
vendor/
.bundle/
Gemfile.lock

# Editor / OS clutter
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
# ...except the shared editor settings, which stop VS Code from
# red-squiggling the Jekyll templates that end in .json.
!.vscode/
!.vscode/settings.json
.idea/

# Credentials. The scripts read CLOUDINARY_URL (api key AND secret) from the
# environment, and the easiest way to set that is a .env file — which must
# never be committed. Nothing here today, and this is what keeps it that way.
.env
.env.*
!.env.example

# Python tooling for the import scripts
scripts/__pycache__/
scripts/*.pyc
scripts/.venv/
scripts/venv/

# Blogger XML exports — keep them local, don't commit (often huge + private)
*.xml
!_data/*.xml
.claude/

# Local audit / migration working files
.audit/
